        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "geosite:private"
        ],
        "outboundTag": "direct"
      },
      {
        "type": "field",
        "domain": [
          "regexp:(^|\\.)ru$",
          "regexp:(^|\\.)xn--p1ai$",
          "regexp:(^|\\.)su$",
          "domain:2gis.ru",
          "domain:2gis.com",
          "domain:dgis.ru",
          "domain:maps.2gis.com",
          "domain:static.maps.2gis.com",
