{
  "api": {
    "listen": "[::1]:10085",
    "services": [
      "StatsService"
    ],
    "tag": "api"
  },
  "dns": {
    "hosts": {
      "domain:googleapis.cn": "googleapis.com"
    },
    "queryStrategy": "UseIPv4",
    "servers": [
      {
        "address": "77.88.8.8",
        "domains": [
          "geosite:category-ru",
          "geosite:private"
        ],
        "timeout": 600,
        "unexpectedIPs": [
          "geoip:private"
        ]
